# Use Ubuntu 22.04 as the base image
FROM agabriel/edger:v1

RUN Rscript -e "install.packages(c('ggpubr', 'msigdbr'), repos = 'https://cran.rstudio.com/', upgrade = 'never')"
RUN Rscript -e "install.packages(c('BiocManager'), repos = 'https://cran.rstudio.com/', upgrade = 'never')"
RUN Rscript -e "BiocManager::install(c('tximport'), update=FALSE)"
# Use the existing env
ENV CONDA_ENV=EdgeR

# Install into the EXISTING conda env (no new envs)
RUN conda install -n ${CONDA_ENV} -c conda-forge \
      bioconda::bioconductor-gsva

RUN Rscript -e "BiocManager::install(c('ComplexHeatmap'), update=FALSE)"
RUN Rscript -e "install.packages(c('readxl'), repos = 'https://cran.rstudio.com/', upgrade = 'never')"

#r-magick imagemagick pkg-config
RUN apt-get clean && rm -rf /var/lib/apt/lists/*
RUN conda clean --all -y
RUN rm -rf /opt/conda/pkgs/*

CMD ["bash"]
